{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mebel-order-1.1.schema.json",
  "title": "Заказ - общий формат Мебельного конструктора, версия 1.1",
  "description": "Формальное описание файла *.mebel.json. Незнакомые поля разрешены везде и должны сохраняться инструментами. Размеры - в миллиметрах, деньги - целые тенге.",
  "type": "object",
  "required": ["format", "version", "id", "client", "products", "catalog"],
  "properties": {
    "format": { "const": "mebel-order" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+$", "description": "Версия формата. 1.x читается любым инструментом версии 1." },
    "id": { "type": "string", "minLength": 1, "description": "Постоянный id заказа. Не меняется никогда." },
    "number": { "type": "string", "description": "Номер заказа для людей и документов, например 2026-014." },
    "title": { "type": "string" },
    "createdAt": { "$ref": "#/$defs/date" },
    "updatedAt": { "$ref": "#/$defs/date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "Код валюты ISO 4217: KZT, RUB, BYN, UZS, KGS, USD, EUR. Все суммы заказа - в этой валюте." },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "Страна мастера: KZ или RU. Задаёт шаблон договора, реквизиты, способы оплаты. Нет поля - страна по валюте." },
    "units": { "const": "mm" },
    "audience": { "enum": ["client"], "description": "Стоит у копии для клиента (forClient): в ней нет себестоимости." },
    "stage": { "$ref": "#/$defs/stage" },
    "client": { "$ref": "#/$defs/client" },
    "seller": { "$ref": "#/$defs/seller" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
    "catalog": { "$ref": "#/$defs/catalog" },
    "extras": { "type": "array", "items": { "$ref": "#/$defs/extra" } },
    "pricing": { "$ref": "#/$defs/pricing" },
    "production": { "$ref": "#/$defs/production" },
    "quote": { "$ref": "#/$defs/quote" },
    "terms": { "$ref": "#/$defs/terms" },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineItem" } },
    "deadline": { "$ref": "#/$defs/date" },
    "payments": { "type": "array", "items": { "$ref": "#/$defs/payment" } },
    "expenses": { "type": "array", "items": { "$ref": "#/$defs/expense" } },
    "reminders": { "type": "array", "items": { "$ref": "#/$defs/reminder" } },
    "measure": { "type": "object", "description": "Замер: дата, кто мерил, размеры помещения, заметки. Состав свободный." },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "notes": { "type": "string" },
    "history": { "type": "array", "items": { "type": "object" } },
    "x": { "type": "object", "description": "Служебные данные инструментов: x.calculator, x.tracker и так далее. Чужие разделы не трогать." }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$", "description": "2026-11-14 или 2026-11-14T10:30:00Z" },
    "money": { "type": "number", "description": "Тенге" },
    "stage": { "enum": ["lead", "measure", "design", "contract", "production", "install", "done", "cancelled"] },
    "xyz": { "type": "object", "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "size": { "type": "object", "properties": { "w": { "type": "number" }, "h": { "type": "number" }, "d": { "type": "number" } }, "description": "Габариты: ширина, высота, глубина" },
    "rot": { "enum": [0, 90, 180, 270], "description": "Поворот вокруг вертикальной оси, градусы" },
    "client": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string", "description": "Если номер WhatsApp отличается от phone" },
        "address": { "type": "string", "description": "Адрес установки" },
        "iin": { "type": "string", "description": "ИИН для договора" },
        "doc": { "type": "string", "description": "Документ для договора" },
        "source": { "type": "string", "description": "Откуда пришёл клиент" },
        "note": { "type": "string" }
      }
    },
    "seller": {
      "type": "object",
      "description": "Реквизиты исполнителя на момент заказа - для КП и договора",
      "properties": {
        "name": { "type": "string" }, "bin": { "type": "string" }, "address": { "type": "string" }, "phone": { "type": "string" },
        "iban": { "type": "string" }, "bank": { "type": "string" }, "bik": { "type": "string" }, "director": { "type": "string" },
        "logo": { "type": "string", "description": "Картинка как data:URL" }
      }
    },
    "catalog": {
      "type": "object",
      "required": ["materials"],
      "properties": {
        "materials": { "type": "object", "additionalProperties": { "$ref": "#/$defs/material" } },
        "edges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/edge" } },
        "hardware": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hardwareItem" } }
      }
    },
    "material": {
      "type": "object",
      "required": ["kind", "t"],
      "properties": {
        "name": { "type": "string" },
        "group": { "type": "string", "description": "ldsp, dvp, mdf, glass, top или своё" },
        "kind": { "enum": ["sheet", "area", "length"], "description": "Как считается: листами, квадратными метрами, погонными метрами" },
        "t": { "type": "number", "exclusiveMinimum": 0, "description": "Толщина, мм" },
        "sheet": { "type": "object", "required": ["w", "h"], "properties": { "w": { "type": "number" }, "h": { "type": "number" } }, "description": "Размер листа. Текстура идёт вдоль w." },
        "grain": { "type": "boolean", "description": "Есть рисунок с направлением (древесный декор)" },
        "decor": { "type": "string" },
        "code": { "type": "string", "description": "Артикул поставщика" },
        "supplier": { "type": "string" },
        "price": { "$ref": "#/$defs/money", "description": "За лист, м2 или п.м. - по kind" },
        "usagePct": { "type": "number", "description": "Своё использование листа для этого материала, %" },
        "cut": { "type": "boolean", "description": "Брать плату за распил и кромление" },
        "color": { "type": "string", "description": "Цвет для эскиза и 3D, #rrggbb" },
        "texture": { "type": "string", "description": "Картинка текстуры: ссылка или data:URL" }
      },
      "if": { "properties": { "kind": { "const": "sheet" } } },
      "then": { "required": ["sheet"] }
    },
    "edge": {
      "type": "object",
      "required": ["t"],
      "properties": {
        "name": { "type": "string" },
        "t": { "type": "number", "exclusiveMinimum": 0, "description": "Толщина, мм" },
        "w": { "type": "number", "description": "Ширина ленты, мм" },
        "price": { "$ref": "#/$defs/money", "description": "За метр" },
        "code": { "type": "string" }, "supplier": { "type": "string" }, "color": { "type": "string" }
      }
    },
    "hardwareItem": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "unit": { "type": "string" }, "price": { "$ref": "#/$defs/money" }, "code": { "type": "string" }, "supplier": { "type": "string" } }
    },
    "hardwareLine": {
      "type": "object",
      "required": ["qty"],
      "anyOf": [{ "required": ["item"] }, { "required": ["name"] }],
      "properties": {
        "item": { "type": "string", "description": "Ключ из catalog.hardware" },
        "name": { "type": "string", "description": "Название. Если есть item - можно не писать." },
        "qty": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "price": { "$ref": "#/$defs/money", "description": "Своя цена. Если нет - берётся из каталога." },
        "note": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["kupe", "kitchen", "univ"] },
        "template": { "type": "string", "description": "Шаблон: cabinet, tumba, bed и так далее" },
        "name": { "type": "string" },
        "qty": { "type": "number", "minimum": 1 },
        "size": { "$ref": "#/$defs/size" },
        "pos": { "$ref": "#/$defs/xyz", "description": "Положение изделия в помещении (необязательно)" },
        "rot": { "$ref": "#/$defs/rot" },
        "finish": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Отделка: роль -> ключ материала или кромки. Детали ссылаются на роль как \"@corpus\"." },
        "params": { "type": "object", "description": "Входные параметры, по которым изделие построено" },
        "generator": { "type": "object", "properties": { "id": { "type": "string" }, "version": { "type": "number" }, "manual": { "type": "boolean", "description": "Детали правили руками - не перестраивать без спроса" } } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
        "hardware": { "type": "array", "items": { "$ref": "#/$defs/hardwareLine" } },
        "describe": { "type": "array", "items": { "type": "string" }, "description": "Готовые строки описания для клиента" },
        "image": { "type": "object", "properties": { "svg": { "type": "string" }, "png": { "type": "string", "description": "data:URL" } } },
        "note": { "type": "string" }
      }
    },
    "module": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "description": "Вид модуля: section, slide-door, lower-sink, upper-shelf и так далее" },
        "name": { "type": "string" },
        "pos": { "$ref": "#/$defs/xyz", "description": "Куда встаёт левый нижний задний угол модуля" },
        "rot": { "$ref": "#/$defs/rot" },
        "size": { "$ref": "#/$defs/size" },
        "wall": { "type": ["string", "number"], "description": "У какой стены стоит (для кухни)" },
        "params": { "type": "object" },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
        "hardware": { "type": "array", "items": { "$ref": "#/$defs/hardwareLine" } },
        "note": { "type": "string" }
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "mat", "o", "a", "b"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "mark": { "type": "string", "description": "Маркировка для наклейки, например 1.3-07" },
        "role": { "enum": ["side", "top", "bottom", "shelf", "partition", "back", "plinth", "facade", "drawer", "countertop", "apron", "filler", "other"] },
        "mat": { "type": "string", "minLength": 1, "description": "Ключ из catalog.materials или роль из finish: \"@corpus\"" },
        "o": { "enum": ["X", "Y", "Z"], "description": "Положение: вдоль какой оси идёт толщина. X - вертикальная боковая, Y - горизонтальная, Z - фронтальная" },
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
        "a": { "type": "number", "minimum": 0, "description": "X: высота; Y: ширина; Z: ширина" },
        "b": { "type": "number", "minimum": 0, "description": "X: глубина; Y: глубина; Z: высота" },
        "qty": { "type": "integer", "minimum": 1 },
        "grain": { "enum": ["a", "b", "any"], "description": "Текстура вдоль размера a, вдоль b или не важно" },
        "edges": {
          "type": "object",
          "description": "Кромка по сторонам: значение - ключ из catalog.edges или роль \"@edge\". X: front, back, top, bottom. Y: front, back, left, right. Z: top, bottom, left, right.",
          "propertyNames": { "enum": ["front", "back", "left", "right", "top", "bottom"] },
          "additionalProperties": { "type": ["string", "null"] }
        },
        "facade": {
          "type": "object",
          "properties": {
            "open": { "enum": ["left", "right", "up", "down", "drawer", "slide", "fixed"], "description": "left/right - с какой стороны петли; up/down - откидной; drawer - ящик; slide - купе; fixed - глухой" },
            "handle": { "type": "string" }
          }
        },
        "ops": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "description": "cutout, groove, hole, radius или своё" }, "note": { "type": "string" } } }, "description": "Обработка: вырезы, пазы, отверстия. В версии 1.0 - свободное описание." },
        "note": { "type": "string", "description": "Подсказка сборщику" }
      },
      "dependentRequired": { "x": ["y", "z"], "y": ["x", "z"], "z": ["x", "y"] }
    },
    "extra": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["item", "delivery", "install", "service"], "description": "item - своя позиция (идёт в материалы); остальное - услуги" },
        "name": { "type": "string" },
        "qty": { "type": "number" },
        "unit": { "type": "string" },
        "price": { "$ref": "#/$defs/money", "description": "Себестоимость за единицу" }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Правила расчёта цены",
      "properties": {
        "workPct": { "type": "number", "minimum": 0, "description": "Сборка, % от материалов" },
        "markupPct": { "type": "number", "minimum": 0, "description": "Наценка, % от себестоимости" },
        "markupServices": { "type": "boolean", "description": "false - наценка не берётся с услуг (доставка, монтаж). По умолчанию берётся со всей себестоимости" },
        "discountPct": { "type": "number", "minimum": 0, "maximum": 90 },
        "prepayPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "roundTo": { "type": "number", "minimum": 1, "description": "Итог округляется вверх до этой суммы" },
        "sheetUsagePct": { "type": "number", "minimum": 30, "maximum": 100, "description": "Использование листа, %" },
        "edgeReservePct": { "type": "number", "minimum": 0, "description": "Запас кромки, %" },
        "cutPerSheet": { "$ref": "#/$defs/money", "description": "Распил и кромление за лист" }
      }
    },
    "production": {
      "type": "object",
      "properties": {
        "kerf": { "type": "number", "description": "Ширина пропила, мм" },
        "sheetTrim": { "type": "number", "description": "Обрезь края листа, мм" },
        "subtractEdge": { "type": "boolean", "description": "Уменьшать размер пиления на толщину кромки от 1 мм" }
      }
    },
    "quoteLine": {
      "type": "object",
      "required": ["name", "sum"],
      "properties": {
        "group": { "enum": ["material", "edge", "cutting", "hardware", "extra", "service"] },
        "kind": { "enum": ["product", "extra", "service"] },
        "ref": { "type": "string" },
        "name": { "type": "string" }, "note": { "type": "string" },
        "qty": { "type": "number" }, "unit": { "type": "string" },
        "price": { "$ref": "#/$defs/money" }, "sum": { "$ref": "#/$defs/money" }
      }
    },
    "quote": {
      "type": "object",
      "description": "Результат расчёта - то, что видел клиент. Другие инструменты его только читают.",
      "required": ["total"],
      "properties": {
        "calcAt": { "$ref": "#/$defs/date" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "Валюта, в которой сделан расчёт (совпадает с currency заказа)" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/quoteLine" }, "description": "Подробно для мастера (себестоимость)" },
        "materials": { "$ref": "#/$defs/money" }, "work": { "$ref": "#/$defs/money" }, "services": { "$ref": "#/$defs/money" },
        "cost": { "$ref": "#/$defs/money" }, "markup": { "$ref": "#/$defs/money" }, "profit": { "$ref": "#/$defs/money" },
        "clientLines": { "type": "array", "items": { "$ref": "#/$defs/quoteLine" }, "description": "Строки для клиента. Их сумма равна subtotal." },
        "subtotal": { "$ref": "#/$defs/money", "description": "Цена до скидки" },
        "discountPct": { "type": "number" },
        "discountSum": { "$ref": "#/$defs/money", "description": "subtotal - discountSum = total" },
        "total": { "$ref": "#/$defs/money", "description": "Итого клиенту" },
        "prepayPct": { "type": "number" },
        "prepaySum": { "$ref": "#/$defs/money" }
      }
    },
    "terms": {
      "type": "object",
      "properties": {
        "days": { "type": "number", "description": "Срок изготовления" },
        "daysKind": { "enum": ["work", "calendar"], "description": "Рабочие или календарные дни" },
        "warrantyMonths": { "type": "number" },
        "validDays": { "type": "number", "description": "Сколько дней действует предложение" },
        "note": { "type": "string" }
      }
    },
    "timelineItem": {
      "type": "object",
      "required": ["stage"],
      "properties": { "stage": { "$ref": "#/$defs/stage" }, "plan": { "$ref": "#/$defs/date" }, "done": { "$ref": "#/$defs/date" }, "note": { "type": "string" } }
    },
    "payment": {
      "type": "object",
      "required": ["date", "amount"],
      "properties": {
        "id": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "kind": { "enum": ["prepay", "payment", "refund"] },
        "method": { "type": "string", "description": "cash, kaspi, sbp, card, transfer, other" },
        "note": { "type": "string" }
      }
    },
    "expense": {
      "type": "object",
      "required": ["amount"],
      "properties": {
        "id": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "amount": { "type": "number" },
        "category": { "type": "string", "description": "materials, facades, hardware, cutting, countertop, delivery, install, other" },
        "supplier": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "reminder": {
      "type": "object",
      "required": ["date"],
      "properties": { "id": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "text": { "type": "string" }, "done": { "type": "boolean" } }
    },
    "file": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "kind": { "type": "string", "description": "photo, sketch, quote, contract, measure, other" },
        "url": { "type": "string", "description": "Ссылка или data:URL" },
        "date": { "$ref": "#/$defs/date" }
      }
    }
  }
}
